[Unit]
Description=Timestamp Notebook Python API
Wants=network-online.target
After=network-online.target

[Service]
User=notebook
Group=notebook
WorkingDirectory=/opt/timestamp-notebook
EnvironmentFile=/etc/timestamp-notebook.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/timestamp-notebook/.venv/bin/uvicorn main:app --host 10.20.2.10 --port 8000 --workers 1 --no-proxy-headers
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
